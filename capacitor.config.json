{
  "appId": "ru.sitrak.obd.diagnostics",
  "appName": "Sitrak S7H Diagnostics",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#020617",
      "showSpinner": false
    }
  }
}
